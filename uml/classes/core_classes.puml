@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ranksep 60
skinparam linetype ortho

package "db" {
  class Base <<declarative_base>> {
  }

  class Project {
    + id: str
    + name: str
    + created_at: datetime
    --
    + proposals: List[Proposal]
    + decisions: List[Decision]
    + audit_logs: List[AuditLog]
    + roadmap_tasks: List[RoadmapTask]
    + background_tasks: List[BackgroundTask]
  }

  class Team {
    + id: str
    + name: str
    + vote_weight: int
    + paradigm_specialty: str
  }

  class Proposal {
    + id: str
    + project_id: str
    + topic: str
    + description: str
    + options: List[str]
    + status: str
    + rationales: List[Dict[str, Any]]
    + votes: List[Dict[str, Any]]
    + created_at: datetime
    + updated_at: datetime
    --
    + project: Project
  }

  class Decision {
    + id: str
    + project_id: str
    + date: date
    + topic: str
    + decision: str
    + rationale: str
    --
    + project: Project
    + alternatives: List[Alternative]
  }

  class Alternative {
    + id: str
    + decision_id: str
    + option: str
    + pros: str
    + cons: str
    --
    + decision: Decision
  }

  class AuditLog {
    + id: str
    + project_id: str
    + timestamp: datetime
    + summary: str
    + alignment_score: float
    + auditor_team: str
    --
    + project: Project
  }

  class RoadmapTask {
    + id: str
    + project_id: str
    + phase: int
    + task: str
    + status: str
    + notes: str
    --
    + project: Project
  }

  class BackgroundTask {
    + id: str
    + project_id: str
    + task_type: str
    + proposal_id: str
    + status: str
    + error_message: str
    + created_at: datetime
    + updated_at: datetime
    --
    + project: Project
    + proposal: Proposal
  }

  Base <|-- Project
  Base <|-- Team
  Base <|-- Proposal
  Base <|-- Decision
  Base <|-- Alternative
  Base <|-- AuditLog
  Base <|-- RoadmapTask
  Base <|-- BackgroundTask

  Project "1" *-- "*" Proposal
  Project "1" *-- "*" Decision
  Project "1" *-- "*" AuditLog
  Project "1" *-- "*" RoadmapTask
  Project "1" *-- "*" BackgroundTask
  Decision "1" *-- "*" Alternative
  BackgroundTask --> Proposal : "references"
}

package "core" {
  class CouncilOrchestrator {
    - _prompter: AgentPrompter
    --
    + __init__(prompter: Optional[AgentPrompter])
    + prompter(): AgentPrompter
    + create_proposal(workspace_dir, project_id, description, proposal_id, topic, options): Proposal
    + run_deliberation(workspace_dir, proposal_id): Proposal
    + run_voting(workspace_dir, proposal_id, max_cycles): Proposal
    + ratify_proposal(workspace_dir, proposal_id, selected_option, alternative_status, next_proposal_desc): Proposal
  }

  class AgentPrompter {
    - _client: Optional[genai.Client]
    --
    + __init__(client: Optional[genai.Client])
    + client(): genai.Client
    + probe_connectivity(): void
    + probe_connectivity_async(): void
    + generate_proposal_inception(description: str): InceptionResponse
    + generate_deliberation_async(team_name, paradigm_specialty, title, description, options): DeliberationResponse
    + generate_vote_async(team_name, paradigm_specialty, title, description, options, rationales, vote_history, round_num): VoteResponse
  }

  class AgentRegistry {
    + get_teams(workspace_dir): List[Team]
    + get_team(workspace_dir, team_id): Optional[Team]
  }

  CouncilOrchestrator --> AgentPrompter : "delegates AI queries"
  CouncilOrchestrator --> AgentRegistry : "queries team list"
}

@endum
