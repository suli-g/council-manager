# Council Manager API Configuration
# Copy this file to '.env' and fill in your values.

# The API key used for accessing Gemini models (required for orchestration)
GEMINI_API_KEY=your_gemini_api_key_here

# The LLM model used by the orchestrator (can be a Gemini model or a local Ollama model).
# Supported env variables: LLM_MODEL, OLLAMA_MODEL, or GEMINI_MODEL.
# Default: gemini-3.5-flash
LLM_MODEL=gemini-3.5-flash

# --- Custom LLM Provider Configuration (Optional) ---
# Supported providers: "google", "openai", "ollama" (Default: google)
LLM_PROVIDER=google

# Custom provider base URL. 
# For Ollama: defaults to http://localhost:11434/v1
# For OpenAI: defaults to https://api.openai.com/v1
# LLM_API_BASE=http://localhost:11434/v1

# Custom provider API key (if needed). Defaults to GEMINI_API_KEY value if not set.
# LLM_API_KEY=your_custom_provider_key_here

